# ── microCMS（お知らせ管理）接続設定 ──
# ローカル開発では .env.local にコピーして使用。Cloudflare Pages では
# プロジェクトの「環境変数」に同じキーを設定する。
# 両方とも未設定の場合は src/data/newsData.ts のお知らせが表示される（移行前と同じ）。

# microCMS のサービスID（管理画面URL https://XXXX.microcms.io の XXXX 部分）
VITE_MICROCMS_SERVICE_DOMAIN=

# microCMS の APIキー（GET 専用キーを推奨。ブラウザに埋め込まれるため管理権限は付けない）
VITE_MICROCMS_API_KEY=

# 任意：お知らせ API のエンドポイントID（microCMS で作る API の ID）。既定は news
VITE_MICROCMS_NEWS_ENDPOINT=news
